# Secrets: never commit keys or env files
.env
.env.*
*.env
*.pem
*.key
*.p12
*service-account*.json
*credentials*.json
*-key.json
secrets/

# Local data, output and debug dumps (scraped data must never be committed)
data/
output/
out/
debug/
dumps/
snapshots/
*.snapshot.json
*.csv
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Node (site check)
node_modules/

# Private dashboard build output (generated by private/build.sh)
private/src/config.json
private/public/present/
.wrangler/
